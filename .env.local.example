# Concert Cost Tracker — environment variables
#
# 1. Copy this file to .env.local in the same folder
# 2. Supabase → ConcertCosts → Settings → API Keys
# 3. NEXT_PUBLIC_SUPABASE_URL = Project URL
# 4. NEXT_PUBLIC_SUPABASE_ANON_KEY = legacy "anon" public key (starts with eyJ…)
#    If login shows "API error" or 401, use the anon key — not the secret key.
#    Publishable keys (sb_publishable_…) work on newer setups; anon is the safest fix.
# 5. NEVER put service_role or secret keys in this file.
# 6. Stop and restart: npm run dev
#
# Map geocoding uses OpenStreetMap Nominatim (no API key).
# Ticket search opens external sites in the browser (no API key).

NEXT_PUBLIC_SUPABASE_URL=https://hloxppqhtfkkvxmuzwfo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
