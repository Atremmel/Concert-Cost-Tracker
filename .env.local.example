# Concert Cost Tracker — environment variables
#
# 1. Copy this file to .env.local in the same folder
# 2. Open Supabase → ConcertCosts project → Settings → API Keys
#    (or use the Connect dialog)
# 3. Copy the Project URL into NEXT_PUBLIC_SUPABASE_URL
# 4. Copy the publishable key into NEXT_PUBLIC_SUPABASE_ANON_KEY
#    (If you only see an older "anon" public key, use that instead.)
# 5. NEVER put a service role or secret key here — those stay server-side only.
# 6. After saving .env.local, stop npm run dev and start it again.

NEXT_PUBLIC_SUPABASE_URL=https://hloxppqhtfkkvxmuzwfo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
